v=1760726780","width":1600,"height":1600},{"id":47503415083201,"created_at":"2025-05-09T19:51:34-03:00","position":12,"updated_at":"2025-10-17T15:46:20-03:00","product_id":10724785684673,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0823\/7953\/8625\/files\/Asa_r15_12.png?v=1760726780","width":1600,"height":1600},{"id":47681863745729,"created_at":"2025-05-30T13:14:48-03:00","position":13,"updated_at":"2025-10-17T15:46:20-03:00","product_id":10724785684673,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0823\/7953\/8625\/files\/76037C02-56F3-43C2-9F0A-12C63B3535E0.jpg?v=1760726780","width":3000,"height":4000},{"id":47681863647425,"created_at":"2025-05-30T13:14:48-03:00","position":14,"updated_at":"2025-10-17T15:46:20-03:00","product_id":10724785684673,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0823\/7953\/8625\/files\/6092BBBD-DE7E-48D4-B2A2-75D0C1345EDE.jpg?v=1760726780","width":2268,"height":4032},{"id":47681863811265,"created_at":"2025-05-30T13:14:48-03:00","position":15,"updated_at":"2025-10-17T15:46:20-03:00","product_id":10724785684673,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0823\/7953\/8625\/files\/8E997142-5F2D-4856-8951-5A943A80F619.jpg?v=1760726780","width":3024,"height":4032}],"options":[{"name":"Cor","position":1,"values":["Bolha Preta + Bico Preto (AllBlack)","Bolha Preta + Bico Azul","Bolha Preta + Bico Fibra de Carbono","Bolha Fumê + Bico Preto","Bolha Fumê + Bico Azul","Bolha Fumê + Bico Fibra de Carbono","Bolha Cristal + Bico Preto","Bolha Cristal + Bico Azul","Bolha Cristal + Bico Fibra de Carbono"]}]},{"id":10714341769409,"title":"Kit Acessórios - Eliminador de Rabeta + Pisca Led (Brinde: Pisca Embutido) | YZF R15","handle":"kit-eliminador","body_html":"\u003cp style=\"text-align: center;\"\u003e\u003cstrong\u003e\u003cspan style=\"text-decoration: underline;\"\u003eÚltimas Unidades!!!\u003c\/span\u003e\u003cem\u003e\u003cbr\u003eKit Exclusivo Somente HOJE!!! \u003cbr\u003e\u003c\/em\u003e\u003c\/strong\u003e\u003c\/p\u003e\n\u003cp style=\"text-align: center;\" class=\"ql-align-center\"\u003e\u003cstrong\u003eSobre o Suporte de Placa (Rabeta Eliminador):\u003cbr\u003e\u003c\/strong\u003eO \u003cem\u003esuporte de placa\u003c\/em\u003e tipo \u003cem\u003eeliminador\u003c\/em\u003e é perfeito pra quem quer dar um visual mais limpo, esportivo e agressivo pra \u003cem\u003eYamaha R15.\u003c\/em\u003e Ele substitui a rabeta original, deixando a traseira da moto mais compacta e com cara de pista. Ideal pra quem curte projetos personalizados e quer se destacar na rua ou nos encontros de motos.\u003cbr\u003e\u003c\/p\u003e\n\u003cp class=\"ql-align-center\" style=\"text-align: center;\"\u003e\u003cstrong\u003eCaracterísticas principais:\u003cbr\u003e\u003c\/strong\u003eDesign enxuto e esportivo, com acabamento reforçado\u003cbr data-start=\"599\" data-end=\"602\"\u003e\u003cem\u003e✅ Visual mais “racing” e minimalista\u003c\/em\u003e\u003cbr data-start=\"638\" data-end=\"641\"\u003e\u003cem\u003e✅ Instalação nos pontos originais da moto – sem adaptações\u003c\/em\u003e\u003cbr data-start=\"699\" data-end=\"702\"\u003e\u003cem\u003e✅ Fabricado em material resistente (geralmente aço carbono ou alumínio)\u003c\/em\u003e\u003cbr data-start=\"773\" data-end=\"776\"\u003e\u003cem\u003e✅ Pode incluir suporte para pisca e iluminação de placa\u003c\/em\u003e\u003cbr data-start=\"831\" data-end=\"834\"\u003e\u003cem\u003e✅ Compatível com a Yamaha R15 e modelos similares\u003c\/em\u003e\u003cbr\u003e\u003c\/p\u003e\n\u003cp class=\"ql-align-center\" style=\"text-align: center;\"\u003e\u003cstrong\u003eAjuda na performance:\u003cbr\u003e\u003c\/strong\u003eSim\u003cem\u003e, no estilo e na leveza.\u003cbr data-start=\"947\" data-end=\"950\"\u003e\u003c\/em\u003eAo eliminar a rabeta original, você reduz o peso na traseira e melhora levemente a aerodinâmica, o que dá um toque mais esportivo na pilotagem.\u003cbr data-start=\"1093\" data-end=\"1096\"\u003eAlém disso, o visual “clean” da traseira traz uma estética mais profissional, como as motos de competição. É aquele tipo de upgrade visual que transforma a moto sem gastar muito.\u003cem\u003e\u003cbr\u003e\u003cbr\u003e\u003cstrong\u003eInstalação:\u003cbr\u003e\u003c\/strong\u003eSuper prática!\u003c\/em\u003e\u003cbr data-start=\"1313\" data-end=\"1316\"\u003eO suporte foi projetado pra encaixar direto nos furos originais da moto, então:\u003cbr data-start=\"1395\" data-end=\"1398\"\u003e\u003cem\u003e➡️ Não precisa furar, soldar ou fazer adaptações.\u003c\/em\u003e\u003cbr data-start=\"1447\" data-end=\"1450\"\u003e\u003cem\u003e➡️ É só remover a rabeta original e fixar o eliminador com os parafusos certos.\u003c\/em\u003e\u003cbr data-start=\"1529\" data-end=\"1532\"\u003e\u003cem\u003e➡️ Alguns modelos já vêm com fiação pra luz de placa.\u003c\/em\u003e\u003cbr data-start=\"1585\" data-end=\"1588\"\u003e\u003cem\u003eVocê pode instalar em casa com ferramentas simples ou pedir pro mecânico fazer – rapidinho tá pronto!\u003cbr\u003e\u003cbr\u003e\u003cstrong\u003e\u003cspan style=\"color: rgb(0, 154, 54);\"\u003eFicou com alguma dúvida? Clique no botão Abaixo \u003cspan style=\"color: rgb(7, 128, 17);\"\u003e\"Fale Agora por WhatsApp\"\u003c\/span\u003e\u003cbr\u003e⬇️⬇️⬇️\u003c\/span\u003e\u003c\/strong\u003e\u003c\/em\u003e\u003cstrong\u003e\u003cem\u003e\u003c\/em\u003e\u003c\/strong\u003e\u003c\/p\u003e\n\u003cdiv style=\"text-align: left;\"\u003e\u003ca href=\"http:\/\/api.whatsapp.com\/send\/?phone=5532991042903\u0026amp;text=Gostaria+de+Tirar+uma+D%C3%BAvida!\u0026amp;type=phone_number\u0026amp;app_absent=0\" rel=\"noopener\" target=\"_blank\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0823\/7953\/8625\/files\/imagem_2025-04-17_225124829_600x600.png?v=1744941111\" alt=\"\" style=\"margin-bottom: 16px; float: none;\"\u003e\u003c\/a\u003e\u003c\/div\u003e","published_at":"2025-05-14T15:26:19-03:00","created_at":"2025-04-20T17:10:14-03:0