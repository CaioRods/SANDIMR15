files\/4.png?v=1745002521","width":1600,"height":1600},{"id":47368236531905,"created_at":"2025-04-18T11:18:47-03:00","position":5,"updated_at":"2025-04-18T15:55:25-03:00","product_id":11026720030913,"variant_ids":[50425996574913],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0823\/7953\/8625\/files\/6.png?v=1745002525","width":1600,"height":1600},{"id":47368236400833,"created_at":"2025-04-18T11:18:47-03:00","position":6,"updated_at":"2025-04-18T15:55:28-03:00","product_id":11026720030913,"variant_ids":[50425996607681],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0823\/7953\/8625\/files\/7.png?v=1745002528","width":1600,"height":1600},{"id":47368236564673,"created_at":"2025-04-18T11:18:47-03:00","position":7,"updated_at":"2025-04-18T15:55:30-03:00","product_id":11026720030913,"variant_ids":[50425996640449],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0823\/7953\/8625\/files\/8.png?v=1745002530","width":1600,"height":1600},{"id":47368236433601,"created_at":"2025-04-18T11:18:47-03:00","position":8,"updated_at":"2025-04-18T15:55:32-03:00","product_id":11026720030913,"variant_ids":[50425996673217],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0823\/7953\/8625\/files\/9.png?v=1745002532","width":1600,"height":1600}],"options":[{"name":"Cor","position":1,"values":["Preto","Azul","Vermelho","Fibra de Carbono"]}]},{"id":11026720489665,"title":"Protetor de Manete SBM 250 - Design Esportivo","handle":"protetor-de-manete-sbm-250-design-esportivo","body_html":"\u003cdiv style=\"text-align: start;\"\u003e\n\u003cimg style=\"margin-top: -7px; margin-bottom: -7px; float: none;\" src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0823\/7953\/8625\/files\/planilha_financeira_23.png?v=1746322327\"\u003e\u003cbr\u003e\u003cem\u003e\u003cbr\u003e\u003c\/em\u003e\n\u003cp class=\"ql-align-center\" style=\"text-align: center;\"\u003e\u003cstrong\u003eSobre o Protetor de Punho:\u003c\/strong\u003e\u003cbr data-end=\"627\" data-start=\"624\"\u003eO \u003cem\u003eProtetor de Punho\u003c\/em\u003e foi desenvolvido especialmente para pilotos que buscam mais \u003cstrong\u003esegurança, estilo e proteção durante a pilotagem.\u003c\/strong\u003e\u003cbr data-end=\"314\" data-start=\"311\"\u003eAlém de oferecer um visual mais \u003cstrong\u003eagressivo e esportivo\u003c\/strong\u003e para a \u003cem\u003eSBM 250\u003c\/em\u003e, ele protege suas mãos contra o vento, detritos e pequenos impactos do dia a dia ou em uso esportivo.\u003cbr\u003e\u003cbr\u003e\u003c\/p\u003e\n\u003cp style=\"text-align: center;\" class=\"ql-align-center\"\u003e\u003cstrong data-end=\"1012\" data-start=\"981\"\u003eCaracterísticas principais:\u003c\/strong\u003e\u003cbr data-end=\"1015\" data-start=\"1012\"\u003eDesign esportivo e funcional para a \u003cem\u003eSBM 250\u003c\/em\u003e\u003cbr data-start=\"570\" data-end=\"573\"\u003e\u003cem\u003e✅ Estrutura em alumínio + acabamento em plástico ABS de alta resistência\u003c\/em\u003e\u003cbr data-start=\"645\" data-end=\"648\"\u003e\u003cem\u003e✅ Protege as mãos contra vento, chuva e pequenos impactos\u003c\/em\u003e\u003cbr data-start=\"705\" data-end=\"708\"\u003e\u003cem\u003e✅ Melhora o visual da moto com estilo mais racing\u003c\/em\u003e\u003cbr data-start=\"757\" data-end=\"760\"\u003e\u003cem\u003e✅ Ajuda a proteger alavancas de freio e embreagem em quedas leves\u003c\/em\u003e\u003cbr data-start=\"825\" data-end=\"828\"\u003e\u003cem\u003e✅ Universal para modelos com guidão esportivo\u003c\/em\u003e\u003cbr data-start=\"915\" data-end=\"918\"\u003e\u003cem\u003e✅ Fácil de limpar e resistente ao tempo\u003cbr\u003e\u003c\/em\u003e\u003cbr\u003e\u003c\/p\u003e\n\u003cp style=\"text-align: center;\" class=\"ql-align-center\"\u003e\u003cstrong data-end=\"1424\" data-start=\"1399\"\u003eAjuda na performance:\u003c\/strong\u003e\u003cbr data-end=\"1427\" data-start=\"1424\"\u003e\u003cstrong\u003eCom certeza!\u003c\/strong\u003e O \u003cem\u003eprotetor de Punho vai além da estética.\u003c\/em\u003e Ele proporciona uma experiência de pilotagem mais confortável ao reduzir o impacto direto do vento nas mãos, principalmente em trajetos longos ou em alta velocidade.\u003cbr data-start=\"1204\" data-end=\"1207\"\u003eAlém disso, protege componentes sensíveis como alavancas de freio e embreagem contra possíveis quedas ou batidas, o que aumenta a vida útil das peças e evita custos inesperados.\u003cbr\u003e\u003cbr\u003e\u003cbr\u003e\u003cstrong data-end=\"1872\" data-start=\"1849\"\u003eSobre a Instalação:\u003c\/strong\u003e\u003cbr data-end=\"1875\" data-start=\"1872\"\u003eA instalação é \u003cem\u003esimples e pode ser feita em casa!\u003c\/em\u003e\u003cbr data-start=\"1465\" data-end=\"1468\"\u003eO protetor de mão acompanha os parafusos e suportes necessários, e se adapta bem ao guidão da \u003cem\u003eSBM 250\u003c\/em\u003e \u003cstrong\u003esem a necessidade de alterações estruturais.\u003c\/strong\u003e\u003cbr data-start=\"1613\" data-end=\"1616\"\u003eEm poucos minutos, sua moto estará com um novo visual e uma camada extra de proteção, sem complicação.\u003cbr\u003e\u003cbr\u003e\u003c\/p\u003e\n\u003cp class=\"ql-align-center\" style=\"text-align: center;\"\u003e\u003cstrong\u003e\u003cem\u003e\u003cspan style=\"color: rgb(5, 131, 16);\"\u003eVeja Agora o Valor Original se você fizesse a Importação!\u003c\/span\u003e\u003cbr\u003e\u003c\/em\u003e\u003c\/strong\u003e\u003cstrong\u003e⬇️⬇️⬇️\u003cbr\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0823\/7953\/8625\/files\/Design_sem_nome_23.png?v=1746321704\" style=\"margin-top: -7px; margin-bottom: -7px; float: none;\"\u003e\u003cbr\u003e\u003cspan style=\"color: rgb(255, 0, 0);\"\u003eQuase de \u003cem\u003eR$ 100,00\u003c\/em\u003e Somente de \u003cem\u003eIMPOSTOS!!!\u003cbr\u003e\u003c\/em\u003eUm Valor Absurdo.\u003c\/span\u003e\u003cbr\u003e\u003cspan style=\"color: rgb(0, 154, 54);\"\u003e\u003cbr\u003eFicou com alguma dúvida? Clique no botão Abaixo \u003cem\u003e\u003cspan style=\"color: rgb(7, 128, 17);\"\