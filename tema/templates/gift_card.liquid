{% layout none %}
<!doctype html>
<html lang="pt-BR">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Vale-presente · {{ shop.name }}</title>
  {{ 'sandim.css' | asset_url | stylesheet_tag }}
  {{ content_for_header }}
</head>
<body>
  <div class="wrap pagina">
    <img src="{{ 'logo-cores.svg' | asset_url }}" alt="{{ shop.name }}" width="240" height="80">
    <h1>Seu vale-presente</h1>
    <p>Saldo: <b>{{ gift_card.balance | money }}</b>{% if gift_card.expired %} · expirado{% elsif gift_card.expires_on %} · válido até {{ gift_card.expires_on | date: '%d/%m/%Y' }}{% endif %}</p>
    <div class="contato-box"><p>Código</p><b class="codigo">{{ gift_card.code | format_code }}</b></div>
    <p><a class="btn" href="{{ shop.url }}">Usar na loja</a></p>
  </div>
</body>
</html>
