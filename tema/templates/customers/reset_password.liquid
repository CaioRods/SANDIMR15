<div class="wrap pagina conta">
  <h1>Nova senha</h1>
  {%- form 'reset_customer_password' -%}
    {{ form.errors | default_errors }}
    <label for="senha">Nova senha</label><input id="senha" type="password" name="customer[password]" autocomplete="new-password" required>
    <label for="senha2">Confirme a senha</label><input id="senha2" type="password" name="customer[password_confirmation]" autocomplete="new-password" required>
    <button class="btn cheio" type="submit">Salvar senha</button>
  {%- endform -%}
</div>
