<div class="wrap pagina conta">
  <p><a href="{{ routes.account_url }}">← Minha conta</a></p>
  <h1>Pedido {{ order.name }}</h1>
  <p>Feito em {{ order.created_at | date: '%d/%m/%Y' }} · {{ order.financial_status_label }} · {{ order.fulfillment_status_label }}</p>
  {%- for item in order.line_items -%}
    <div class="item-pedido">
      <span>{{ item.title }} × {{ item.quantity }}</span>
      {%- if item.fulfillment -%}
        <span>Rastreio: {% if item.fulfillment.tracking_url %}<a href="{{ item.fulfillment.tracking_url }}" target="_blank" rel="noopener">{{ item.fulfillment.tracking_number }}</a>{% else %}{{ item.fulfillment.tracking_number }}{% endif %}</span>
      {%- endif -%}
      <b>{{ item.final_line_price | money }}</b>
    </div>
  {%- endfor -%}
  <div class="tot"><span>Total</span><b>{{ order.total_price | money }}</b></div>
  <h2>Entrega</h2>
  <p>{{ order.shipping_address | format_address }}</p>
</div>
