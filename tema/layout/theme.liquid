<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
    <meta name="theme-color" content="#0A1430">
    <link rel="canonical" href="{{ canonical_url }}">
    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 64, height: 64 }}">
    {%- else -%}
      <link rel="icon" type="image/png" href="{{ 'favicon.png' | asset_url }}">
    {%- endif -%}
    <link rel="apple-touch-icon" href="{{ 'apple-touch-icon.png' | asset_url }}">
    <title>{{ page_title }}{% if current_tags %} · {{ current_tags | join: ', ' }}{% endif %}{% if current_page != 1 %} · Página {{ current_page }}{% endif %}{% unless page_title contains shop.name %} · {{ shop.name }}{% endunless %}</title>
    {%- if page_description -%}<meta name="description" content="{{ page_description | escape }}">{%- endif -%}
    {% render 'meta-tags' %}

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Kanit:ital,wght@1,600;1,700;1,800&family=Barlow:wght@400;500;600;700&family=Barlow+Semi+Condensed:wght@500;600;700&display=swap">
    {{ 'sandim.css' | asset_url | stylesheet_tag }}
    <script>
      window.Sandim = {
        coef12x: {{ settings.parcela_coef | default: 0.101326 | json }},
        moeda: {{ cart.currency.iso_code | json }},
        rotas: { add: {{ routes.cart_add_url | json }}, change: {{ routes.cart_change_url | json }}, cart: {{ routes.cart_url | json }} },
        loader: {{ settings.loader_ativo | json }}
      };
    </script>
    <script src="{{ 'cinema.js' | asset_url }}" defer></script>
    <script src="{{ 'sandim.js' | asset_url }}" defer></script>
    {{ content_for_header }}
  </head>

  <body data-template="{{ template.name }}">
    <a class="pular" href="#conteudo">Pular para o conteúdo</a>
    {%- if settings.loader_ativo and template.name != 'cart' -%}
      {% render 'loader' %}
    {%- endif -%}

    {% sections 'header-group' %}

    <main id="conteudo" tabindex="-1">
      {{ content_for_layout }}
    </main>

    {% sections 'footer-group' %}

    {% render 'barra-inferior' %}
    <div class="veu" id="veu" hidden></div>
    {% render 'gaveta-carrinho' %}
    {%- if settings.whatsapp_numero != blank -%}
      <a class="whats" href="https://wa.me/{{ settings.whatsapp_numero | remove: ' ' | remove: '+' | remove: '-' | remove: '(' | remove: ')' }}" target="_blank" rel="noopener" aria-label="Atendimento no WhatsApp">
        {% render 'icone', nome: 'whatsapp' %}
      </a>
    {%- endif -%}
    <div class="toast" id="toast" role="status" aria-live="polite"></div>
  </body>
</html>
